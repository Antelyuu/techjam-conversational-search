__pycache__/
*.py[cod]
.DS_Store
.env
results.json
# Ablation outputs are regenerable by their scripts. The figures that matter are
# transcribed into docs/experiments/.
fusion_ablation.json
clarification_ablation.json
rerank_ablation.json
rerank_weight_sweep.json
# The catalogue is distributed through the organiser's participant-kit release and
# is fetched at setup time; see docs/SETUP.md.
data/catalog.jsonl
data/releases/
# The MiniLM artifact is bundled so the optional dense route runs in a fresh
# runtime. bge-small is excluded: that model line was discontinued by team
# decision (E1) and its artifact is 73 MB.
data/embeddings/bge-small-en-v1.5.*
# Full-precision value-level artifacts (E11): one vector per distinct card
# value, 268,564 of them, so 393 MB at 384 dimensions and 2.1 GB at Voyage's
# native 2048. These are the comparison builds, rebuildable with
# scripts/build_value_embeddings.py, and none of them can be committed.
#
# The *shipped* artifact is deliberately not matched by these patterns:
# data/embeddings/voyage-4-nano-values256.npy is 66 MB -- Matryoshka-truncated
# to 256 dimensions and stored int8 -- and is tracked, like the MiniLM dense
# artifact beside it, so a fresh checkout has the feature without a rebuild.
# Its .values.json is not needed at runtime either: the agent derives the row
# labelling from the catalogue it already loads (semantic_evidence.catalogue_values).
data/embeddings/*-values.npy
data/embeddings/*-values.values.json
SHA256SUMS
# Organizer-only code, private evaluation data, manifests, and build reports.
organizer/
secure/
